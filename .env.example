# Generate a real one for any real deploy:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-string
DEBUG=True
# "*" is fine for local dev (DEBUG=True) so ngrok's rotating subdomains
# work without editing this every session. Lock this down for real deploys.
ALLOWED_HOSTS=*
# Set to True only once the reverse proxy in front of this app terminates
# TLS and forwards X-Forwarded-Proto - see launchlab/settings.py.
SECURE_SSL_REDIRECT=False

# Shared site-wide password (HTTP Basic Auth - core/basic_auth.py).
# Blank = disabled, which is correct for local dev. REQUIRED once this is
# reachable from the open internet, since every page/API endpoint here is
# otherwise unauthenticated by design - pick a real random password, not
# something guessable, it's the only thing standing in front of the API.
SITE_BASIC_AUTH_USER=
SITE_BASIC_AUTH_PASSWORD=

# Local venv dev (running `manage.py runserver` directly against the
# docker-compose db/redis, reaching them via their host-mapped ports):
DB_NAME=launchlab
DB_USER=launchlab
DB_PASSWORD=launchlab
DB_HOST=localhost
DB_PORT=5433

REDIS_URL=redis://localhost:6379/0

# Docker-compose deploy (the `web` service reaches `db`/`redis` by their
# service names on their internal container ports, not the host-mapped
# ones above):
#   DB_HOST=db
#   DB_PORT=5432
#   REDIS_URL=redis://redis:6379/0
